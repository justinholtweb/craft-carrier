<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ 'Labels'|t('carrier') }}</title>
<style>
    {% if layout == '4x6' %}
        @page { size: 4in 6in; margin: 0; }
        body { margin: 0; }
        .label { width: 4in; height: 6in; page-break-after: always; display: flex; align-items: center; justify-content: center; }
        .label img { max-width: 100%; max-height: 100%; }
    {% else %}
        @page { size: A4; margin: 6mm; }
        body { margin: 0; font-family: system-ui, sans-serif; }
        .sheet { display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 140mm; gap: 4mm; }
        .label { display: flex; align-items: center; justify-content: center; break-inside: avoid; }
        .label img { max-width: 100%; max-height: 100%; }
        .label:nth-child(4n) { break-after: page; }
    {% endif %}
    .toolbar { padding: 8px; background: #eee; }
    @media print { .toolbar { display: none; } }
</style>
</head>
<body>
<div class="toolbar">
    <button onclick="window.print()">{{ 'Print'|t('carrier') }}</button>
    <a href="?{{ craft.app.request.queryString|replace({'layout=4x6': '', 'layout=a4': ''}) }}&layout=a4">A4, 4 per page</a> ·
    <a href="?{{ craft.app.request.queryString|replace({'layout=4x6': '', 'layout=a4': ''}) }}&layout=4x6">4×6 thermal</a>
</div>
<div class="sheet">
    {% for image in images %}<div class="label"><img src="{{ image }}" alt=""></div>{% endfor %}
</div>
</body>
</html>
